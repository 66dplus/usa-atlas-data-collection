[Unit]
Description=Explicit one-shot USA Atlas storage compaction
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/Documents/Codex/2026-09-28/https-github-com-66dplus-usa-atlas/usa-atlas-data-collection
ExecStart=/usr/bin/python3 -u database/cleanup_storage.py compact --apply
Restart=no
TimeoutStartSec=infinity
RemainAfterExit=yes
UMask=0077
# Manual template only: no Install section and no automatic restart on failures.
# Do not start while the independently launched maintenance process is active.
