      "properties": {
        "snippet": "The Rural Health Transformation Program (RHTP) is a $50 billion federal opportunity to improve health care in rural areas across the 50 states. \n\n",
        "extent": null,
        "commentsEnabled": true,
        "groupDesignations": null,
        "access": "public",
        "apiToken2ExpirationDate": -1,
        "typeKeywords": [
          "Map",
