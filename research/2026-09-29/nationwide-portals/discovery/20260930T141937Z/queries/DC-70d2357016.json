      "title": "Responding to COVID-19 in Emergency Shelters",
      "url": "https://storymaps.arcgis.com/stories/b8c0374078644c5298ad2b6b8dfbf751",
      "publisher": "Content_Admin1",
      "status": "needs_review",
      "publisher_verified": false,
      "native_geography": null,
      "production_admission": false,
      "properties": {
        "snippet": "How DC is protecting and supporting those experiencing homelessness during the coronavirus (COVID-19) pandemic",
        "extent": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                -77.22575918267839,
                39.00086195800861
