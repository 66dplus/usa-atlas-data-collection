      "properties": {
        "snippet": "With median housing prices above the national average, how can D.C. lawmakers find solutions to the housing crisis?",
        "extent": null,
        "commentsEnabled": true,
        "groupDesignations": null,
        "access": "public",
        "apiToken2ExpirationDate": -1,
        "typeKeywords": [
