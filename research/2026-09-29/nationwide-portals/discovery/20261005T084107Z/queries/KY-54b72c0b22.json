      "properties": {
        "snippet": "A compilation of Kentucky’s physiographic regions that have been reorganized based on general characteristics, specifically as they relate to groundwater occurrence.",
        "extent": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                -89.704434,
