      "native_geography": null,
      "production_admission": false,
      "properties": {
        "snippet": "The ECS Worksheet database was developed to provide a statewide repository for vegetation data and the boundaries between native plant communities. The immediate purpose is to help foresters make maps of native plant communities. The ultimate purpose is to monitor vegetation change due to management or external factors such as climate change.",
        "extent": {
          "type": "Polygon",
          "coordinates": [
