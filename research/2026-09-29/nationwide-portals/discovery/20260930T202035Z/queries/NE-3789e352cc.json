      "properties": {
        "snippet": "Shoreline boundaries for lakes and reservoirs in Nebraska where bathymetric surveys have been conducted.",
        "extent": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                -103.84267849883564,
