      "properties": {
        "snippet": "Priority projects, photos and more from SWRPC's Ashuelot Rail Trail planning effort.",
        "extent": null,
        "commentsEnabled": true,
        "groupDesignations": null,
        "access": "public",
        "typeKeywords": [
