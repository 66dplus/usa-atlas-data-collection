      "native_geography": null,
      "production_admission": false,
      "properties": {
        "snippet": "Promoting Outdoor Play Recreation Sites Interactive Tool",
        "extent": null,
        "commentsEnabled": true,
        "groupDesignations": null,
        "access": "public",
