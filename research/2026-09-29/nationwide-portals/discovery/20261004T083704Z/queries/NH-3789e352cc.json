    {
      "id": "546dbf4d8f7f4d5cbd1a628dd931a46a",
      "title": "Promoting Outdoor Play",
      "url": "https://srpc.maps.arcgis.com/apps/MapSeries/index.html?appid=546dbf4d8f7f4d5cbd1a628dd931a46a",
