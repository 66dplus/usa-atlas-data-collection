      "properties": {
        "snippet": "This Metropolitan Council table, describing Local Origin-Destination Employment Statistics - Workplace Area Characteristics, provides local approximation of employment levels and characteristics.",
        "extent": null,
        "commentsEnabled": true,
        "groupDesignations": null,
        "access": "public",
        "apiToken2ExpirationDate": -1,
        "typeKeywords": [
          "Feature Access",
