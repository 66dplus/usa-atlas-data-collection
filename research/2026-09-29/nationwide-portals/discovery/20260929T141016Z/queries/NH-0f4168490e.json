      "title": "Land Conservation Plan 2016 Update - Public Water Supply",
      "url": "https://nhgeodata.unh.edu/hosting/rest/services/Hosted/EC_LandConservationPlanDatasets/FeatureServer/3",
      "publisher": "NHGRANIT",
      "status": "needs_review",
