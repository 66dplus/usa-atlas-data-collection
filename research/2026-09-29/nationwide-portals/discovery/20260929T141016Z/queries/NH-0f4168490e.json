      "id": "dadbb60cb2c145f8bfa7fed751042830",
      "title": "Lead in School Drinking Water Dashboard 2025",
      "url": "https://www.nhgeodata.unh.edu/api/search/v1/collections/all/items/dadbb60cb2c145f8bfa7fed751042830",
      "publisher": "NHGRANIT",
