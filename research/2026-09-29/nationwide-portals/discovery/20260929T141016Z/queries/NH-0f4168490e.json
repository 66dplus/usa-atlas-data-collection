      "native_geography": null,
      "production_admission": false,
      "properties": {
        "snippet": "Land conservation focus areas identified for the purpose of protecting coastal water resources. Focus Areas include Pollutant Attenuation, Flood Storage and Risk Mitigation, Public Water Supply, and Single and Multi-Benefit Water Resources.",
        "extent": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                -71.3647,
                43.622
              ],
              [
                -70.6299,
                43.622
