      "production_admission": false,
      "properties": {
        "snippet": "This layer shows oil and gas wells in Kansas that were part of the Type Logs Project. Log ASCII Standard (LAS) 3.0 files are available for these wells. ",
        "extent": {
          "type": "Polygon",
          "coordinates": [
            [
