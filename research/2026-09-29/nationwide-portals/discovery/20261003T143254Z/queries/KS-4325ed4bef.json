      "production_admission": false,
      "properties": {
        "snippet": "This data layer shows cumulative oil production in Kansas aggregated by section and measured in barrels (bbls). The Kansas Geological Survey (KGS) manages the data. ",
        "extent": {
          "type": "Polygon",
          "coordinates": [
            [
