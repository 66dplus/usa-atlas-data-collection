[Unit]
Description=USA Atlas 30-minute research timer health monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=@REPO@
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 @REPO@/ops/continuous_monitor.py
TimeoutStartSec=180
UMask=0077
Nice=10
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=usa-atlas-continuous-monitor
StateDirectoryMode=0700
ReadWritePaths=@REPO@/ops/research_week/runtime
PrivateTmp=yes
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal
