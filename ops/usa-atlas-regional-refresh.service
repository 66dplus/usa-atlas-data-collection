[Unit]
Description=USA Atlas daily regional aggregate refresh
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=/root/Documents/Codex/2026-09-28/https-github-com-66dplus-usa-atlas/usa-atlas-data-collection
ExecCondition=/usr/bin/python3 /root/Documents/Codex/2026-09-28/https-github-com-66dplus-usa-atlas/usa-atlas-data-collection/ops/scraper_watchdog.py --preflight regional-refresh
ExecStart=/usr/bin/python3 -u /root/Documents/Codex/2026-09-28/https-github-com-66dplus-usa-atlas/usa-atlas-data-collection/research/2026-09-29/regional-expansion/refresh_regional.py
Restart=on-failure
RestartSec=300
TimeoutStartSec=1800
TimeoutStopSec=60
KillMode=control-group
UMask=0022
StandardOutput=journal
StandardError=journal
