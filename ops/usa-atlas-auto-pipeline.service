[Unit]
Description=USA Atlas verified collection artifact preparation and database admission
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=/root/Documents/Codex/2026-09-28/https-github-com-66dplus-usa-atlas/usa-atlas-data-collection
ExecStart=/usr/bin/python3 -u /root/Documents/Codex/2026-09-28/https-github-com-66dplus-usa-atlas/usa-atlas-data-collection/ops/auto_pipeline.py --once --apply
Restart=on-failure
RestartSec=300
TimeoutStartSec=2800
TimeoutStopSec=60
KillMode=control-group
UMask=0077
Nice=10
StandardOutput=journal
StandardError=journal
