[Unit]
Description=USA Atlas rotating discovery across 50 states DC and Puerto Rico
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=/root/Documents/Codex/2026-09-28/https-github-com-66dplus-usa-atlas/usa-atlas-data-collection
ExecCondition=/usr/bin/python3 /root/Documents/Codex/2026-09-28/https-github-com-66dplus-usa-atlas/usa-atlas-data-collection/ops/scraper_watchdog.py --preflight nationwide-discovery
ExecStart=/usr/bin/python3 -u /root/Documents/Codex/2026-09-28/https-github-com-66dplus-usa-atlas/usa-atlas-data-collection/research/2026-09-29/nationwide-portals/scheduled_discovery.py
Restart=on-failure
RestartSec=900
TimeoutStartSec=3900
TimeoutStopSec=60
KillMode=control-group
UMask=0022
StandardOutput=journal
StandardError=journal
